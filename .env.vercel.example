# Exemplo para Vercel + Aiven MySQL + Brevo SMTP.
# Somente valores ilustrativos: não salve credenciais reais neste arquivo.
# Na Vercel: Project Settings > Environment Variables.
# Cadastre as variáveis para Production e faça um novo deployment após alterações.
# Para Preview, use banco isolado, segredo próprio e a origem HTTPS do Preview.
# Este arquivo não é carregado automaticamente pelo Next.js.
#
# Legenda:
# ALTERAR: substitua o valor pela configuração real do ambiente.
# CONFERIR: pode manter o exemplo se corresponder ao seu ambiente/provedor.
# OPCIONAL: descomentar somente quando precisar sobrescrever o padrão.

# --- Banco e autenticação: obrigatórios no modo persistente ---

# ALTERAR: copie a conexão do Aiven e use o banco destinado ao ambiente.
# Codifique caracteres especiais do usuário/senha na URL (percent-encoding).
# O runtime valida TLS; não use sslaccept=accept_invalid_certs.
# Prisma CLI pode exigir sslcert/sslaccept=strict conforme a configuração da CA.
DATABASE_URL="mysql://ALTERAR_USUARIO:ALTERAR_SENHA@ALTERAR_HOST:3306/selic?sslaccept=strict"

# CONFERIR: domínio principal da aplicação. ALTERAR se usar outro domínio.
# Somente origem, sem /login ou outros caminhos; HTTPS obrigatório em produção.
BETTER_AUTH_URL="https://tcc-selic3.vercel.app"

# ALTERAR: segredo aleatório exclusivo deste ambiente, com pelo menos 32 caracteres.
# Gere localmente com: openssl rand -base64 32
# Mantenha o segredo estável entre deployments; não compartilhe com Preview.
BETTER_AUTH_SECRET=""

# ALTERAR SE NECESSÁRIO: CA do Aiven quando não for confiável para o Node.
# Cole o conteúdo PEM, não o caminho do arquivo. Aceita quebras reais ou \n.
# SELIC_DB_CA_CERT="-----BEGIN CERTIFICATE-----\nALTERAR_CONTEUDO_DA_CA\n-----END CERTIFICATE-----"

# CONFERIR: força uso do banco; nunca configure "simulado" em Production.
SELIC_PERSISTENCIA="persistente"

# --- E-mail: Brevo (recuperação/estabelecimento de senha e confirmação de e-mail) ---
# Obrigatórios para entrega de e-mail; não são exigidos para exibir o login.

# CONFERIR: mantenha para Brevo; ALTERAR caso troque de provedor.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
# Porta 587 usa STARTTLS; false significa sem TLS implícito.
# Para porta 465, use SMTP_SECURE=true conforme o provedor.
SMTP_SECURE=false

# ALTERAR: login exibido na aba SMTP do Brevo.
SMTP_USER=""
# ALTERAR: chave SMTP gerada no Brevo, não a senha da conta nem a chave de API.
SMTP_PASSWORD=""
# ALTERAR: endereço cadastrado e verificado como remetente no Brevo.
SMTP_FROM="SELic <ALTERAR_REMETENTE@exemplo.com>"

# --- Ajustes opcionais de conexão (os valores abaixo já são os padrões) ---
# SELIC_DB_CONNECTION_LIMIT=5
# SELIC_DB_CONNECT_TIMEOUT_MS=10000
# SELIC_DB_ACQUIRE_TIMEOUT_MS=12000
# SELIC_DB_INITIALIZATION_TIMEOUT_MS=8000

# Não cadastre TEST_DATABASE_URL ou TEST_APP_DATABASE_URL na Vercel:
# essas variáveis pertencem aos testes locais isolados de .env.example.
# NODE_ENV é definido pela plataforma. Não use NEXT_PUBLIC_ em segredos.
