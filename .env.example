# Conexão do banco MySQL do Aiven usada pelo Prisma CLI (migrações/seed).
#
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
# No Aiven, copie os dados em "Connection information" do serviço MySQL.
# O runtime da aplicação usa a variável DATABASE_URL através do driver adapter
# (src/lib/db/prisma.ts), com TLS habilitado.
#
# Copie este arquivo para `.env` e preencha com as credenciais reais.
# O runtime valida a cadeia do certificado e o hostname. Se o serviço usar
# uma CA privada, configure SELIC_DB_CA_CERT com o PEM fornecido pelo serviço.
# O Prisma CLI tem configuração TLS própria na URL (sslcert/sslaccept=strict).
DATABASE_URL="mysql://usuario:senha@host:porta/selic?sslaccept=strict&connect_timeout=30"

# PEM da CA do serviço, com quebras reais ou escapadas como \n.
# SELIC_DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SELIC_DB_CONNECTION_LIMIT=5
# SELIC_DB_CONNECT_TIMEOUT_MS=10000
# SELIC_DB_ACQUIRE_TIMEOUT_MS=12000
# SELIC_DB_INITIALIZATION_TIMEOUT_MS=8000

# Seleção explícita da fonte de dados. "persistente" exige DATABASE_URL;
# "simulado" ignora o banco. Sem valor, produção/desenvolvimento usam o banco
# quando DATABASE_URL existe e os testes unitários permanecem em simulação.
# SELIC_PERSISTENCIA="persistente"

# Origem canônica do deployment, sem caminho; HTTPS em produção.
BETTER_AUTH_URL="http://localhost:3000"
# Defina um segredo aleatório de pelo menos 32 caracteres, exclusivo do ambiente.
BETTER_AUTH_SECRET=""

# Transporte dos e-mails de recuperação/estabelecimento de senha.
# SMTP_SECURE=true para TLS implícito (normalmente porta 465).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="SELic <nao-responda@exemplo.com>"
SMTP_USER=""
SMTP_PASSWORD=""

# Banco exclusivo dos testes de integração. Use apenas loopback e o schema
# selic_teste; `npm run test:integration` recusa qualquer outro destino.
# O script `scripts/banco-teste.sh iniciar` cria a instância e imprime a URL.
TEST_DATABASE_URL="mysql://selic_teste:senha@127.0.0.1:33306/selic_teste"
# Schema completo dos modelos, separado da autenticação para evitar que um
# `prisma db push` remova as tabelas do outro.
TEST_APP_DATABASE_URL="mysql://selic_teste:senha@127.0.0.1:33306/selic_teste_app"
